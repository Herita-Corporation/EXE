# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored — never commit real secrets.

# SQL Server sa password (sqlserver, iam-service, task-service)
SA_PASSWORD=Disa2026!Pass

# JWT signing key — MUST match between iam-service, aitour-service,
# task-service, and AI-Itinerary's JWT_SECRET.
JWT_SECRET_KEY=THIS_IS_A_SECRET_KEY_FOR_IAM_SERVICE_123456
