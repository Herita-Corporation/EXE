# Copy this file to .env and fill in real values before running
# `docker compose up` (LOCAL DEV — sqlserver/postgres run as containers).
# .env is gitignored — never commit real secrets.
#
# For production deploy (managed cloud databases, no local sqlserver/
# postgres containers), see `.env.production.example` and
# `docker-compose.prod.yml` instead.

# SQL Server sa password (sqlserver, iam-service, task-service)
SA_PASSWORD=Disa2026!Pass

# JWT signing key — MUST match between iam-service, aitour-service,
# task-service, and AI-Itinerary's JWT_SECRET.
JWT_SECRET_KEY=THIS_IS_A_SECRET_KEY_FOR_IAM_SERVICE_123456

# Gmail App Password for disatravel.support@gmail.com (NOT the regular
# account password) — myaccount.google.com/apppasswords. Used for real
# email verification (registration/Settings). Leave empty to skip —
# iam-service still builds/runs fine, sending just fails with a clear error.
SMTP_PASSWORD=

# Bahnar → Vietnamese translator (OPTIONAL — only for `docker compose --profile translator up`).
# Shared key between aitour-service and bahnar-translator (header X-API-Key). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRANSLATOR_API_KEY=
# Leave empty to use the bahnar-translator container; or point to a translator on another host.
# TRANSLATOR_BASE_URL=http://192.168.1.23:8090
