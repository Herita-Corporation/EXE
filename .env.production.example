# Copy this file to `/home/ubuntu/EXE/.env` and fill in real values before
# running `docker compose -f docker-compose.prod.yml up -d --build` on EC2.
# `.env` is gitignored: never commit populated secrets.
DOMAIN=disatravel.id.vn

# SQL Server and PostgreSQL credentials. Generate strong, distinct values.
SA_PASSWORD=replace_with_a_strong_sql_password
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password

# Must match across IAM, Task, AITour and AI-Itinerary.
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
AI_ITINERARY_API_KEY=replace_with_a_long_random_internal_api_key

# Task service applies safe EF schema migrations on startup.
PREMIUM_APPLY_MIGRATIONS_ON_STARTUP=true

# Direct-APK payment only. Use LIVE only after a test webhook has passed.
SEPAY_ENVIRONMENT=LIVE
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=

# Optional email, SMS and translation integrations.
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Partner Voucher / OC3. Keep disabled until both secret keys are configured.
PARTNER_VOUCHERS_ENABLED=false
PARTNER_VOUCHERS_TOKEN_KEY=
PARTNER_VOUCHERS_SYNC_KEY=
PARTNER_VOUCHERS_IAM_BASE_URL=http://iam-service:8080
PARTNER_VOUCHERS_ALLOW_TEST_CAMPAIGNS=false

# Leave empty when the translator runs as a local compose service.
TRANSLATOR_BASE_URL=
TRANSLATOR_API_KEY=
