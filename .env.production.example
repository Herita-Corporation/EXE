# Copy this file to `.env` (same directory) and fill in real values before
# running `docker compose -f docker-compose.prod.yml up -d --build` on the
# production EC2 instance. This is a SEPARATE file from the root `.env` used
# by docker-compose.yml for local dev — do not mix the two.
#
# .env is gitignored — never commit real secrets.

# Your domain (must already have iam./aitour./task./@ A-records pointing at
# this EC2 instance's Elastic IP — see Phase A in the deploy plan).
DOMAIN=disatravel.id.vn

# SQL Server sa password (sqlserver, iam-service, task-service). Generate a
# new, strong value for production — do NOT reuse the dev placeholder from
# .env.example.
SA_PASSWORD=

# PostgreSQL password (postgres, ai-itinerary*). Generate a new value —
# do NOT reuse the dev placeholder ("postgres") from docker-compose.yml.
POSTGRES_PASSWORD=

# JWT signing key — MUST match between iam-service, aitour-service,
# task-service, and AI-Itinerary's JWT_SECRET. Generate a new, long random
# value for production — do NOT reuse the placeholder from .env.example.
JWT_SECRET_KEY=

# Internal API key AI-Itinerary accepts for service-to-service calls that
# don't carry a user JWT. Generate a new random value.
AI_ITINERARY_API_KEY=
