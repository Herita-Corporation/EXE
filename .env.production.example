# Copy this file to `.env` (same directory) and fill in real values before
# running `docker compose -f docker-compose.prod.yml up -d --build` on the
# production EC2 instance. This is a SEPARATE file from the root `.env` used
# by docker-compose.yml for local dev — do not mix the two.
#
# .env is gitignored — never commit real secrets.

# Your domain (must already have iam./aitour./task./@ A-records pointing at
# this EC2 instance's Elastic IP — see Phase A in the deploy plan).
DOMAIN=disatravel.id.vn

# SQL Server sa password (sqlserver, iam-service, task-service). Generate a
# new, strong value for production — do NOT reuse the dev placeholder from
# .env.example.
SA_PASSWORD=

# PostgreSQL password (postgres, ai-itinerary*). Generate a new value —
# do NOT reuse the dev placeholder ("postgres") from docker-compose.yml.
POSTGRES_PASSWORD=

# JWT signing key — MUST match between iam-service, aitour-service,
# task-service, and AI-Itinerary's JWT_SECRET. Generate a new, long random
# value for production — do NOT reuse the placeholder from .env.example.
JWT_SECRET_KEY=

# Internal API key AI-Itinerary accepts for service-to-service calls that
# don't carry a user JWT. Generate a new random value.
AI_ITINERARY_API_KEY=

# Gmail App Password for disatravel.support@gmail.com (NOT the regular
# account password) — myaccount.google.com/apppasswords. Used for real
# email verification (registration/Settings).
SMTP_PASSWORD=

# Google Play Billing (Premium subscription). The service-account JSON key
# itself goes at secrets/google-play-key.json on the server (NOT an env
# var — see docker-compose.prod.yml), never committed.
# Email of the service account Google Cloud Pub/Sub uses to sign the OIDC
# token on each Real-time Developer Notification push to
# /api/premium/rtdn-webhook — must match exactly or the webhook rejects
# every request. Set up at Play Console > Monetize setup > Real-time
# developer notifications, and GCP Pub/Sub > that topic's push subscription.
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Bahnar → Vietnamese translator (OPTIONAL). ~5 GB RAM → does not fit on the 4 GB t3.medium:
# run it on another host and set TRANSLATOR_BASE_URL, or upgrade the VM and use
# `--profile translator` (see docker-compose.prod.yml). Unset = translate endpoints return 503,
# everything else works as before.
# Shared secret between aitour-service and the translator (X-API-Key). Generate a new random value.
TRANSLATOR_API_KEY=
# e.g. https://translator.disatravel.id.vn — leave empty to use the local bahnar-translator container.
TRANSLATOR_BASE_URL=
