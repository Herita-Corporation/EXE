# ─────────────────────────────────────────────────────────────────────────────
# AI-Itinerary Service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI-Itinerary
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_itinerary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Constructed automatically by config.py — do not set manually
# DATABASE_URL=postgresql+asyncpg://...

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT=30

# ── OSRM (Route Optimization) ──────────────────────────────────────────────────
# Public demo (rate-limited). Replace with self-hosted for production.
OSRM_URL=http://router.project-osrm.org

# ── Overpass API (OSM Data) ────────────────────────────────────────────────────
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Cache ──────────────────────────────────────────────────────────────────────
CACHE_TTL_HOURS=24

# ── Security ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
API_KEY=change-me-in-production

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Optional: Amadeus (flight prices) ─────────────────────────────────────────
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
