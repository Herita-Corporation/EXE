# Copy to deploy/.env on the translator server (deploy/.env is gitignored — never commit it).

# Sub-domain pointing (A-record) at THIS server's Elastic IP, e.g. translator.disatravel.id.vn
TRANSLATOR_DOMAIN=

# Shared secret: the SAME value must be set as TRANSLATOR_API_KEY in the main stack's .env.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRANSLATOR_API_KEY=

# Only needed to download the models (Read token of an account invited to the private HF repo).
HF_TOKEN=
