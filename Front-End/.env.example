# Copy this file to `.env` and adjust the URLs.
#
# IMPORTANT — Expo Go runs on your PHONE, not on this PC. `localhost` on the
# phone means the phone itself, so it will NEVER reach services running on
# your dev machine. Replace `localhost` below with your PC's LAN IP address
# (Windows: run `ipconfig` and use the "IPv4 Address" of your Wi-Fi adapter,
# e.g. 192.168.1.23). Your phone and PC must be on the same Wi-Fi network.
#
# These are only the DEFAULTS baked in at build time. Every value can also be
# overridden at runtime from inside the app: Profile -> API Settings.

# IAMService — auth (login/register/refresh/me)
EXPO_PUBLIC_IAM_API_URL=http://10.87.28.120:5195

# AITourService — proxies itinerary generation to the AI-Itinerary (Python) service
EXPO_PUBLIC_AITOUR_API_URL=http://10.87.28.120:5289

# Task.Presentation — missions / gamification
EXPO_PUBLIC_TASK_API_URL=http://10.87.28.120:5020

