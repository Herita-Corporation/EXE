{
  "expo": {
    "name": "Disa Travel",
    "slug": "disa-travel-frontend",
    "owner": "disa-travel",
    "scheme": "disatravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.disa.travel.frontend"
    },
    "android": {
      "package": "com.disa.travel.frontend",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#1A4A85"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Disa Travel cần quyền truy cập thư viện ảnh để đính kèm minh chứng nhiệm vụ.",
          "cameraPermission": "Disa Travel cần quyền camera để chụp ảnh minh chứng nhiệm vụ."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Disa Travel cần vị trí để xác thực bạn đang ở điểm tham quan khi nộp minh chứng nhiệm vụ."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Disa Travel cần quyền camera để chụp ảnh minh chứng nhiệm vụ.",
          "microphonePermission": "Disa Travel cần quyền micro để quay video minh chứng nhiệm vụ."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/disa-logo-white.png",
          "color": "#1A4A85"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1A4A85"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "dceb64b3-b47b-4c32-ac03-9c37ff2578ab"
      }
    }
  }
}
