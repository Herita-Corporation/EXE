{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_IAM_API_URL": "https://iam.disatravel.id.vn",
        "EXPO_PUBLIC_AITOUR_API_URL": "https://aitour.disatravel.id.vn",
        "EXPO_PUBLIC_TASK_API_URL": "https://task.disatravel.id.vn"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
